# Askalinaw environment — EXAMPLE ONLY. Contains NO secrets.
# On the server, scripts/fetch-secrets.sh writes the real values into LibreChat/.env
# from AWS Systems Manager Parameter Store. Never commit a real .env.

HOST=0.0.0.0
PORT=3080
MONGO_URI=mongodb://mongodb:27017/LibreChat
DOMAIN_CLIENT=https://YOUR-IP.sslip.io
DOMAIN_SERVER=https://YOUR-IP.sslip.io

# --- Identity (reskin) ---
APP_TITLE=Askalinaw
CUSTOM_FOOTER=Askalinaw · Kalinaw University Help Desk (fictional) · SAM10 project by Santiago & Dequiros
HELP_AND_FAQ_URL=https://REPLACE-WITH-YOUR-WEBSITE/system.html

# --- Only the Google (Gemini) endpoint ---
ENDPOINTS=google
GOOGLE_KEY=__FROM_PARAMETER_STORE__
GOOGLE_MODELS=gemini-2.5-flash

# --- Accounts ---
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=false

# --- S3 file storage (instance role supplies credentials) ---
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=__FROM_PARAMETER_STORE__

# --- Secrets generated once and stored in Parameter Store ---
CREDS_KEY=__FROM_PARAMETER_STORE__
CREDS_IV=__FROM_PARAMETER_STORE__
JWT_SECRET=__FROM_PARAMETER_STORE__
JWT_REFRESH_SECRET=__FROM_PARAMETER_STORE__
MEILI_MASTER_KEY=__FROM_PARAMETER_STORE__

# --- Logging (request logs go to CloudWatch) ---
DEBUG_LOGGING=true
CONSOLE_JSON=true
