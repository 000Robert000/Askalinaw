{
  "agent": { "metrics_collection_interval": 60, "run_as_user": "root" },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": { "InstanceId": "${aws:InstanceId}" },
    "metrics_collected": {
      "mem":  { "measurement": ["mem_used_percent"] },
      "disk": { "measurement": ["used_percent"], "resources": ["/"], "drop_device": true }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          { "file_path": "/var/log/caddy/access.log",
            "log_group_name": "/askalinaw/access", "log_stream_name": "{instance_id}",
            "retention_in_days": 14 },
          { "file_path": "/opt/LibreChat/logs/*.log",
            "log_group_name": "/askalinaw/app", "log_stream_name": "{instance_id}",
            "retention_in_days": 14 },
          { "file_path": "/var/lib/docker/containers/*/*-json.log",
            "log_group_name": "/askalinaw/containers", "log_stream_name": "{instance_id}",
            "retention_in_days": 7 },
          { "file_path": "/var/log/askalinaw/automation.log",
            "log_group_name": "/askalinaw/automation", "log_stream_name": "{instance_id}",
            "retention_in_days": 30 }
        ]
      }
    }
  }
}
